    <Compile Include="../../Segmentation/RegionStats.cs" Link="Segmentation/RegionStats.cs" />
    <Compile Include="../../Segmentation/Morphology2D.cs" Link="Segmentation/Morphology2D.cs" />
    <Compile Include="../../Segmentation/RegionGrow2D.cs" Link="Segmentation/RegionGrow2D.cs" />
